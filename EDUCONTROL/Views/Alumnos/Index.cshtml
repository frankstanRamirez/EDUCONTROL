@model IEnumerable<EDUCONTROL.Models.Alumno>
@{
    ViewData["Title"] = "Alumnos";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Encabezado ── *@
<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-people text-primary"></i> Alumnos registrados
        </h2>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 shadow-sm" style="border-radius: 12px; height: 45px;">
        <i class="bi bi-person-plus me-1"></i> + Nuevo alumno
    </a>
</div>

@* ── Tarjetas Total / Activos (CENTRADA) ── *@
<div class="row mb-4 justify-content-center">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 15px; background-color: #f8f9fa;">
            <small class="text-muted fw-bold text-uppercase">Total inscritos</small>
            <div class="fs-2 fw-bold mt-1">@ViewBag.Total</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 15px; background-color: #f8f9fa;">
            <small class="text-muted fw-bold text-uppercase">Activos</small>
            <div class="fs-2 fw-bold text-success mt-1">@ViewBag.Activos</div>
        </div>
    </div>
</div>

@* ── Filtros con Botones a la derecha ── *@
<div class="card border-0 shadow-sm mb-4" style="background-color: #f8f9fa; border-radius: 15px;">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">

            <div class="col-md-4">
                <label class="small fw-bold text-muted d-block mb-1 text-uppercase">Buscar</label>
                <div class="input-group bg-white shadow-sm border" style="border-radius: 25px; overflow: hidden; height: 45px;">
                    <span class="input-group-text bg-white border-0 pe-1">
                        <i class="bi bi-search text-primary"></i>
                    </span>
                    <input name="buscar" value="@ViewBag.Buscar"
                           class="form-control border-0 fw-bold"
                           style="box-shadow: none; font-size: 0.9rem;"
                           placeholder="Buscar por NIE o nombre..." />
                </div>
            </div>

            <div class="col-md-2">
                <label class="small fw-bold text-muted d-block mb-1 text-uppercase">Grado</label>
                <div class="input-group bg-white shadow-sm border" style="border-radius: 25px; overflow: hidden; height: 45px;">
                    <span class="input-group-text bg-white border-0 pe-0 ps-3">
                        <i class="bi bi-mortarboard text-primary"></i>
                    </span>
                    <select name="grado" class="form-select border-0 fw-bold ps-2" style="box-shadow: none; font-size: 0.85rem;">
                        <option value="">Todos los grados</option>
                        @foreach (var g in new[] { "1 grado", "2 grado", "3 grado", "4 grado", "5 grado", "6 grado", "7 grado", "8 grado", "9 grado" })
                        {
                            <option value="@g" selected="@(ViewBag.GradoFiltro == g)">@g</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-2">
                <label class="small fw-bold text-muted d-block mb-1 text-uppercase">Sección</label>
                <div class="input-group bg-white shadow-sm border" style="border-radius: 25px; overflow: hidden; height: 45px;">
                    <span class="input-group-text bg-white border-0 pe-1">
                        <i class="bi bi-collection text-primary"></i>
                    </span>
                    <select name="seccion" class="form-select border-0 fw-bold text-primary" style="box-shadow: none; font-size: 0.9rem;">
                        <option value="">Sección</option>
                        @foreach (var s in new[] { "A", "B", "C", "D" })
                        {
                            <option value="@s" selected="@(ViewBag.SeccionFiltro == s)">@s</option>
                        }
                    </select>
                </div>
            </div>

            @* --- DIV ESPACIADOR QUE EMPUJA LOS BOTONES --- *@
            <div class="col"></div>

            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4 shadow-sm" style="border-radius: 12px; height: 45px;">
                    <i class="bi bi-search me-1"></i> Filtrar
                </button>
                <a asp-action="Index"
                   class="btn btn-outline-secondary shadow-sm d-inline-flex align-items-center justify-content-center"
                   style="border-radius: 12px; height: 45px; width: 45px;">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>

        </form>
    </div>
</div>

@* --- TABLA --- *@
<div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead style="background-color: #f8f9fa;">
                <tr class="text-muted small">
                    <th class="ps-4 text-uppercase">NIE</th>
                    <th class="text-uppercase">Nombre completo</th>
                    <th class="text-uppercase">Grado</th>
                    <th class="text-uppercase text-center">Sección</th>
                    <th class="text-uppercase">Año</th>
                    <th class="text-uppercase">Estado</th>
                    <th class="text-uppercase text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr style="border-bottom: 1px solid #f2f2f2;">
                        <td class="ps-4 fw-bold text-primary" style="font-size: 0.95rem;">@a.NIE</td>
                        <td class="fw-semibold text-dark" style="font-size: 0.95rem;">@a.NombreCompleto</td>
                        <td class="text-muted" style="font-size: 0.9rem;">@a.Grado</td>
                        <td class="text-muted text-center" style="font-size: 0.9rem;">@a.Seccion</td>
                        <td class="text-muted" style="font-size: 0.9rem;">@a.AnioAcademico</td>
                        <td>
                            <span class="badge @(a.Estado == "Activo" ? "bg-success" : "bg-danger")">
                                @a.Estado
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@a.Id"
                               class="btn btn-sm btn-outline-warning shadow-sm"
                               style="border-radius: 8px;">
                                <i class="bi bi-pencil me-1"></i> Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@a.Id"
                               class="btn btn-sm btn-outline-danger shadow-sm"
                               style="border-radius: 8px;">
                                <i class="bi bi-trash me-1"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>