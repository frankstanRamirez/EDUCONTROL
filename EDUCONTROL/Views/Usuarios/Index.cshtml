@model IEnumerable<EDUCONTROL.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<style>
    .form-check-input {
        background-color: #dc3545 !important;
        border-color: #dc3545 !important;
        cursor: pointer;
        height: 1.25em !important;
        width: 2.3em !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='white'/%3e%3c/svg%3e") !important;
    }

        .form-check-input:checked {
            background-color: #198754 !important;
            border-color: #198754 !important;
        }

    .acciones-contenedor {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .user-code {
        color: #d63384;
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }
</style>

@* ── Encabezado ── *@
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0">
        <i class="bi bi-shield-lock text-primary"></i> Usuarios
    </h4>
    <a asp-action="Create"
       class="btn btn-primary px-4 shadow-sm d-flex align-items-center justify-content-center"
       style="border-radius: 12px; height: 45px; width: fit-content;">
        <i class="bi bi-plus-lg me-2"></i>
        <span>Nuevo usuario</span>
    </a>
</div>

@* ── Tabla ── *@
<div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead style="background-color: #f8f9fa;">
                <tr class="text-muted small">
                    <th class="ps-4 text-uppercase">Nombre completo</th>
                    <th class="text-uppercase">Usuario</th>
                    <th class="text-uppercase">Rol</th>
                    <th class="text-uppercase">Grado</th>
                    <th class="text-uppercase">Estado</th>
                    <th class="text-center text-uppercase">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr style="border-bottom: 1px solid #f2f2f2;">
                        <td class="ps-4 fw-semibold text-dark" style="font-size: 0.95rem;">
                            @u.NombreCompleto
                        </td>
                        <td>
                            <code class="user-code">@u.NombreUsuario</code>
                        </td>
                        <td>
                            <span class="badge @(u.Rol == "Director" ? "bg-danger" : u.Rol == "Secretaria" ? "bg-warning text-dark" : "bg-info")">
                                @u.Rol
                            </span>
                        </td>
                        <td class="text-muted" style="font-size: 0.9rem;">
                            @(u.GradoAsignado ?? "—")
                        </td>
                        <td>
                            <span class="badge @(u.Activo ? "bg-success" : "bg-secondary")">
                                @(u.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="acciones-contenedor">
                                <a asp-action="Edit" asp-route-id="@u.Id"
                                   class="btn btn-sm btn-outline-warning shadow-sm"
                                   style="border-radius: 8px;">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleActivo" asp-route-id="@u.Id"
                                      method="post" id="form-@u.Id" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <div class="form-check form-switch p-0 m-0">
                                        <input class="form-check-input m-0" type="checkbox" role="switch"
                                               @(u.Activo ? "checked" : "")
                                               onchange="document.getElementById('form-@u.Id').submit();">
                                    </div>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>
                            <span>No hay usuarios registrados.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>