@using EDUCONTROL.Models
@{
    ViewData["Title"] = "Reporte de Asistencia";
    var detalle = ViewBag.Detalle as IEnumerable<dynamic> ?? new List<dynamic>();
    bool filtrado = ViewBag.FiltroAplicado == true;
}

<style>
    @@media print {
        .no-print, #sidebar, #topnav, .solo-pantalla, .card, .btn, form {
            display: none !important;
        }

        #main {
            margin-left: 0 !important;
            padding: 0 !important;
        }

        body {
            background: #fff !important;
            font-family: Arial, sans-serif !important;
        }

        .reporte-contenedor-print {
            padding: 10mm;
        }

        .header-print {
            text-align: center;
            margin-bottom: 5mm;
        }

        .logo-print {
            height: 60px;
            margin-bottom: 10px;
        }

        .titulo-print {
            font-size: 22pt;
            font-weight: bold;
            color: #333;
            margin-bottom: 15px;
            text-transform: uppercase;
        }

        .linea-decorativa {
            border-top: 3px solid #5cb85c;
            margin-bottom: 20px;
        }

        .info-bloque {
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .info-item {
            font-size: 12pt;
            margin-bottom: 4px;
        }

        .info-label {
            font-weight: bold;
            min-width: 120px;
            display: inline-block;
        }

        .tabla-print {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

            .tabla-print th {
                border: 1px solid #dee2e6;
                padding: 8px;
                background: #f8f9fa !important;
                color: #333;
                font-weight: bold;
                text-align: center;
            }

            .tabla-print td {
                border: 1px solid #dee2e6;
                padding: 8px;
                text-align: center;
            }

        .nombre-estudiante {
            text-align: left !important;
            font-weight: bold;
        }

        .footer-print {
            margin-top: 30px;
            border-top: 2px solid #5cb85c;
            padding-top: 10px;
            font-style: italic;
            color: #666;
            font-size: 10pt;
        }
    }

    @@media screen {
        .solo-impresion {
            display: none !important;
        }
    }
</style>

@* ── Encabezado ── *@
<div class="d-flex align-items-center justify-content-between mb-4 no-print">
    <h3 class="fw-bold mb-0">
        <i class="bi bi-file-earmark-bar-graph text-primary me-2"></i>Reporte de Asistencia
    </h3>
    <button type="button" onclick="window.print()"
            class="btn btn-outline-success shadow-sm @(!filtrado ? "disabled" : "")"
            style="border-radius: 10px;">
        <i class="bi bi-printer me-2"></i>Imprimir Reporte
    </button>
</div>

@* ── Filtros ── *@
<div class="card border-0 shadow-sm mb-4 no-print" style="background-color: #f8f9fa; border-radius: 15px;">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="small fw-bold text-muted d-block mb-1 text-uppercase">Grado</label>
                <div class="input-group bg-white shadow-sm border" style="border-radius: 25px; overflow: hidden; height: 45px;">
                    <span class="input-group-text bg-white border-0 pe-1">
                        <i class="bi bi-mortarboard text-primary"></i>
                    </span>
                    <select name="grado" class="form-select border-0 fw-bold" style="box-shadow: none; font-size: 0.9rem;" required>
                        <option value="">-- Seleccionar --</option>
                        @foreach (var g in new[] { "1 grado", "2 grado", "3 grado", "4 grado", "5 grado", "6 grado", "7 grado", "8 grado", "9 grado" })
                        {
                            <option value="@g" selected="@(ViewBag.GradoFiltro == g)">@g</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-2">
                <label class="small fw-bold text-muted d-block mb-1 text-uppercase">Sección</label>
                <div class="input-group bg-white shadow-sm border" style="border-radius: 25px; overflow: hidden; height: 45px;">
                    <span class="input-group-text bg-white border-0 pe-1">
                        <i class="bi bi-collection text-primary"></i>
                    </span>
                    <select name="seccion" class="form-select border-0 fw-bold text-primary" style="box-shadow: none; font-size: 0.9rem;">
                        <option value="">Todas</option>
                        @foreach (var s in new[] { "A", "B", "C", "D" })
                        {
                            <option value="@s" selected="@(ViewBag.SeccionFiltro == s)">@s</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-3">
                <label class="small fw-bold text-muted d-block mb-1 text-uppercase">Fecha</label>
                <div class="input-group bg-white shadow-sm border" style="border-radius: 25px; overflow: hidden; height: 45px;">
                    <span class="input-group-text bg-white border-0 pe-1">
                        <i class="bi bi-calendar-event text-primary"></i>
                    </span>
                    <input type="date" name="fecha" value="@ViewBag.FechaFiltro"
                           class="form-control border-0 fw-bold"
                           style="box-shadow: none; font-size: 0.9rem;" />
                </div>
            </div>

            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary px-4 shadow-sm" style="border-radius: 12px; height: 45px;">
                    <i class="bi bi-funnel me-1"></i> Filtrar Reporte
                </button>
            </div>

        </form>
    </div>
</div>

@* ── Tabla pantalla ── *@
<div class="card shadow-sm border-0 no-print" style="border-radius: 12px; overflow: hidden;">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead style="background-color: #f8f9fa;">
                <tr class="text-muted small">
                    <th class="ps-4 text-uppercase">#</th>
                    <th class="text-uppercase">Nombre del Estudiante</th>
                    <th class="text-center text-uppercase">Asistencias</th>
                    <th class="text-center text-uppercase">Ausencias</th>
                    <th class="text-center text-uppercase">Tardías</th>
                </tr>
            </thead>
            <tbody>
                @if (detalle.Any())
                {
                    int n = 1;
                    @foreach (var f in detalle)
                    {
                        <tr style="border-bottom: 1px solid #f2f2f2;">
                            <td class="ps-4 text-muted" style="font-size: 0.9rem;">@n</td>
                            <td class="fw-semibold text-dark" style="font-size: 0.95rem;">@f.NombreCompleto</td>
                            <td class="text-center fw-bold text-success">@f.Asistencias</td>
                            <td class="text-center fw-bold text-danger">@f.Ausencias</td>
                            <td class="text-center fw-bold text-warning">@f.Tardias</td>
                        </tr>
                        n++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                            <span>Selecciona un grado y aplica el filtro para ver el reporte.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Vista impresión ── *@
<div class="solo-impresion reporte-contenedor-print">
    <div class="header-print">
        <img src="/images/logo.png" class="logo-print" />
        <div class="titulo-print">REPORTE DE ASISTENCIA</div>
    </div>
    <div class="linea-decorativa"></div>
    <div class="info-bloque">
        <div class="info-item"><span class="info-label">Grado / Curso:</span> @ViewBag.GradoFiltro</div>
        <div class="info-item"><span class="info-label">Sección:</span> @(ViewBag.SeccionFiltro ?? "Todas")</div>
        <div class="info-item"><span class="info-label">Docente:</span> @ViewBag.Docente</div>
        <div class="info-item"><span class="info-label">Fecha:</span> @ViewBag.FechaReporte - @ViewBag.HoraReporte</div>
    </div>
    <table class="tabla-print">
        <thead>
            <tr>
                <th style="width:40px;">Nº</th>
                <th style="text-align:left;">Nombre del Estudiante</th>
                <th>Asistencias</th>
                <th>Ausencias</th>
                <th>Tardías</th>
            </tr>
        </thead>
        <tbody>
            @{
                int np = 1;
            }
            @foreach (var f in detalle)
            {
                <tr>
                    <td>@np</td>
                    <td class="nombre-estudiante">@f.NombreCompleto</td>
                    <td>@f.Asistencias</td>
                    <td>@f.Ausencias</td>
                    <td>@f.Tardias</td>
                </tr>
                np++;
            }
        </tbody>
    </table>
    <div class="footer-print">
        Documento generado automáticamente por el sistema de control escolar.
    </div>
</div>