@using EDUCONTROL.Models
@{
    ViewData["Title"] = "Reporte de Notas";
    var detalle = ViewBag.Detalle as IEnumerable<dynamic> ?? new List<dynamic>();
    bool filtrado = ViewBag.FiltroAplicado == true;
}

<style>
    @@media print {
        .no-print, #sidebar, #topnav, .solo-pantalla {
            display: none !important;
        }

        #main {
            margin-left: 0 !important;
        }

        body {
            background: #fff;
        }

        .reporte-header {
            border-bottom: 3px solid #5cb85c;
            margin-bottom: 20px;
        }

        .reporte-footer {
            border-top: 2px solid #5cb85c;
            margin-top: 40px;
            padding-top: 8px;
            font-style: italic;
            color: #555;
        }
    }

    @@media screen {
        .solo-impresion {
            display: none !important;
        }
    }

    .reporte-header {
        border-bottom: 3px solid #5cb85c;
        margin-bottom: 20px;
    }

    .reporte-footer {
        border-top: 2px solid #5cb85c;
        margin-top: 40px;
        padding-top: 8px;
        font-style: italic;
        color: #555;
    }
</style>

@* ── Encabezado ── *@
<div class="d-flex align-items-center justify-content-between mb-4 no-print">
    <h4 class="fw-bold mb-0">
        <i class="bi bi-file-earmark-text text-primary"></i> Reporte de Notas
    </h4>
    <button type="button" onclick="window.print()"
            class="btn btn-outline-success shadow-sm @(!filtrado ? "disabled" : "")"
            style="border-radius: 10px;">
        <i class="bi bi-printer me-1"></i> Imprimir
    </button>
</div>

@* ── Filtros ── *@
<div class="card border-0 shadow-sm mb-4 no-print" style="background-color: #f8f9fa; border-radius: 15px;">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="small fw-bold text-muted d-block mb-1 text-uppercase">Grado</label>
                <div class="input-group bg-white shadow-sm border" style="border-radius: 25px; overflow: hidden; height: 45px;">
                    <span class="input-group-text bg-white border-0 pe-1">
                        <i class="bi bi-mortarboard text-primary"></i>
                    </span>
                    <select name="grado" class="form-select border-0 fw-bold" style="box-shadow: none; font-size: 0.9rem;" required>
                        <option value="">-- Seleccionar --</option>
                        @foreach (var g in new[] { "1 grado", "2 grado", "3 grado", "4 grado", "5 grado", "6 grado", "7 grado", "8 grado", "9 grado" })
                        {
                            <option value="@g" selected="@(ViewBag.GradoFiltro == g)">@g</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-2">
                <label class="small fw-bold text-muted d-block mb-1 text-uppercase">Sección</label>
                <div class="input-group bg-white shadow-sm border" style="border-radius: 25px; overflow: hidden; height: 45px;">
                    <span class="input-group-text bg-white border-0 pe-1">
                        <i class="bi bi-collection text-primary"></i>
                    </span>
                    <select name="seccion" class="form-select border-0 fw-bold text-primary" style="box-shadow: none; font-size: 0.9rem;">
                        <option value="">Todas</option>
                        @foreach (var s in new[] { "A", "B", "C", "D" })
                        {
                            <option value="@s" selected="@(ViewBag.SeccionFiltro == s)">@s</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-3">
                <label class="small fw-bold text-muted d-block mb-1 text-uppercase">Asignatura</label>
                <div class="input-group bg-white shadow-sm border" style="border-radius: 25px; overflow: hidden; height: 45px;">
                    <span class="input-group-text bg-white border-0 pe-1">
                        <i class="bi bi-book text-primary"></i>
                    </span>
                    <select name="asignaturaId" class="form-select border-0 fw-bold" style="box-shadow: none; font-size: 0.9rem;">
                        <option value="">-- Todas las materias --</option>
                        @foreach (var asig in (List<Asignatura>)ViewBag.Asignaturas)
                        {
                            <option value="@asig.Id" selected="@(ViewBag.AsigFiltro == asig.Id)">@asig.Nombre</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary px-4 shadow-sm" style="border-radius: 12px; height: 45px;">
                    <i class="bi bi-funnel me-1"></i> Filtrar Reporte
                </button>
            </div>

        </form>
    </div>
</div>

@* ── Vista pantalla ── *@
<div class="solo-pantalla">

    @* Tarjeta resumen *@
    <div class="card border-0 shadow-sm mb-3 p-3" style="border-radius: 12px; background-color: #f8f9fa;">
        <div class="row g-3">
            <div class="col-md-3">
                <small class="text-muted fw-bold text-uppercase d-block">Grado / Curso</small>
                <strong class="text-dark">@(ViewBag.GradoFiltro ?? "—")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted fw-bold text-uppercase d-block">Sección</small>
                <strong class="text-dark">@(ViewBag.SeccionFiltro ?? "Todas")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted fw-bold text-uppercase d-block">Promedio General</small>
                <strong class="text-primary">@(ViewBag.PromedioGeneral ?? "—")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted fw-bold text-uppercase d-block">Docente</small>
                <strong class="text-dark">@Context.Session.GetString("UsuarioNombre")</strong>
            </div>
        </div>
    </div>

    @* Tabla *@
    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead style="background-color: #f8f9fa;">
                    <tr class="text-muted small">
                        <th class="ps-4 text-uppercase">Estudiante</th>
                        <th class="text-center text-uppercase">Per. 1</th>
                        <th class="text-center text-uppercase">Per. 2</th>
                        <th class="text-center text-uppercase">Per. 3</th>
                        <th class="text-center text-uppercase">Promedio</th>
                        <th class="text-center text-uppercase">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (detalle.Any())
                    {
                        @foreach (var item in detalle)
                        {
                            <tr style="border-bottom: 1px solid #f2f2f2;">
                                <td class="ps-4 fw-semibold text-dark" style="font-size: 0.95rem;">@item.NombreCompleto</td>
                                <td class="text-center text-muted" style="font-size: 0.9rem;">@item.Periodo1</td>
                                <td class="text-center text-muted" style="font-size: 0.9rem;">@item.Periodo2</td>
                                <td class="text-center text-muted" style="font-size: 0.9rem;">@item.Periodo3</td>
                                <td class="text-center fw-bold">@item.Promedio</td>
                                <td class="text-center">
                                    <span class="badge @(item.Estado == "Aprobado" ? "bg-success" : "bg-danger")"
                                          style="font-size: 0.75rem; min-width: 80px;">
                                        @item.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-file-earmark-x fs-2 d-block mb-2"></i>
                                <span>Selecciona un grado y aplica el filtro para ver el reporte.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ── Vista impresión ── *@
<div class="solo-impresion">
    <div class="reporte-header pb-2 text-center">
        <img src="/images/logo.png" alt="EduControl" style="height:70px;" />
        <h4 class="fw-bold mt-2 mb-0">REPORTE DE NOTAS</h4>
    </div>
    <div class="my-4" style="line-height:1.8">
        <p class="mb-1"><strong>Grado / Curso:</strong> @ViewBag.GradoFiltro</p>
        <p class="mb-1"><strong>Sección:</strong> @(ViewBag.SeccionFiltro ?? "Todas")</p>
        <p class="mb-1"><strong>Asignatura:</strong> @(ViewBag.NombreAsignatura ?? "Todas")</p>
        <p class="mb-1"><strong>Docente:</strong> @Context.Session.GetString("UsuarioNombre")</p>
        <p class="mb-1"><strong>Fecha:</strong> @DateTime.Now.ToString("dd/MM/yyyy") - @DateTime.Now.ToString("HH:mm")</p>
    </div>
    <table class="table table-bordered table-sm">
        <thead class="table-light">
            <tr>
                <th>Nombre del Estudiante</th>
                <th class="text-center">P1</th>
                <th class="text-center">P2</th>
                <th class="text-center">P3</th>
                <th class="text-center">Prom.</th>
                <th class="text-center">Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in detalle)
            {
                <tr>
                    <td>@item.NombreCompleto</td>
                    <td class="text-center">@item.Periodo1</td>
                    <td class="text-center">@item.Periodo2</td>
                    <td class="text-center">@item.Periodo3</td>
                    <td class="text-center"><strong>@item.Promedio</strong></td>
                    <td class="text-center">@item.Estado</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="reporte-footer mt-5">
        Documento generado automáticamente por el sistema de control escolar.
    </div>
</div>